{
  "name": "publish-devto",
  "version": "1.0.0",
  "description": "GitHub Action to publish markdown files as articles on on dev.to platform, with assets hosted on GitHub.",
  "type": "module",
  "repository": {
    "type": "git",
    "url": "https://github.com/sinedied/publish-devto.git"
  },
  "private": true,
  "exports": "./dist/index.js",
  "scripts": {
    "lint": "xo",
    "lint:fix": "xo --fix",
    "build": "rm -rf dist && node scripts/build.js",
    "test": "xo",
    "release": "node -e \"console.error('Run the release workflow from GitHub Actions instead: https://github.com/sinedied/publish-devto/actions/workflows/release.yml'); process.exit(1)\""
  },
  "keywords": [
    "github",
    "actions",
    "dev.to",
    "publish",
    "markdown",
    "assets",
    "articles",
    "sync"
  ],
  "author": {
    "name": "Yohan Lasorsa",
    "url": "https://twitter.com/sinedied"
  },
  "homepage": "https://github.com/sinedied/publish-devto",
  "bugs": {
    "url": "https://github.com/sinedied/publish-devto/issues"
  },
  "license": "MIT",
  "dependencies": {
    "@actions/core": "^1.9.1",
    "@actions/exec": "^1.0.3",
    "@sinedied/devto-cli": "^1.2.0",
    "xo": "^0.58.0"
  },
  "devDependencies": {
    "@vercel/ncc": "^0.38.1"
  },
  "xo": {
    "space": true,
    "prettier": true,
    "envs": [
      "node"
    ],
    "rules": {
      "unicorn/prefer-top-level-await": "off"
    }
  },
  "prettier": {
    "trailingComma": "none",
    "bracketSpacing": true,
    "endOfLine": "auto"
  },
  "engines": {
    "node": ">=24.0.0",
    "npm": ">=11.0.0"
  }
}
